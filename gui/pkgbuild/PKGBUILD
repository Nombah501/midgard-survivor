pkgname=midgardfarm
pkgver=0.1.0
pkgrel=1
pkgdesc='Control panel for the Midgard Survivors farmer'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'python')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/midgardfarm "$pkgdir/usr/bin/midgardfarm"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/midgardfarm.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/midgardfarm.svg"
  install -Dm644 "$startdir/midgardfarm.desktop" "$pkgdir/usr/share/applications/midgardfarm.desktop"
}
