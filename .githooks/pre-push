#!/usr/bin/env bash
# Check every pushed commit as it was committed: export it to a clean directory
# and run the app's type check and tests there (plus the farmer tests when
# farmer/ changed). CI tests only the tip of a push, so a commit that passed
# only with files left uncommitted could otherwise land unnoticed.
# Docs-only commits are skipped. Bypass in an emergency: git push --no-verify.
set -euo pipefail

ZERO=0000000000000000000000000000000000000000
CODE='^(src|tests|packaging|farmer)/|^pyproject\.toml$'
# Work next to uv's cache so the per-commit venv is hardlinked, not copied into /tmp.
WORK_PARENT="${XDG_CACHE_HOME:-$HOME/.cache}/midgard-pre-push"

command -v uv >/dev/null || { echo "pre-push: uv missing; install it or push with --no-verify" >&2; exit 1; }

declare -A seen=()
commits=()
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # Deleting a ref.
  if [ "$remote_sha" = "$ZERO" ]; then
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi
  while read -r commit; do
    [ -n "$commit" ] && [ -z "${seen[$commit]:-}" ] || continue
    seen[$commit]=1
    commits+=("$commit")
  done < <(git rev-list --reverse "${range[@]}")
done

work=""
trap '[ -n "$work" ] && rm -rf "$work"' EXIT

# Run "$@" in directory $1; any failure rejects the push. (A `( ... ) || ...`
# subshell would not do: bash ignores `set -e` inside it.)
run_in() {
  local dir=$1; shift
  if ! (cd "$dir" && "$@"); then
    echo "pre-push: $short fails on its own; fix it (or amend/split) before pushing" >&2
    exit 1
  fi
}

for commit in "${commits[@]}"; do
  changed="$(git diff-tree --no-commit-id --name-only -r --root "$commit")"
  grep -qE "$CODE" <<<"$changed" || continue
  short="$(git log -1 --format=%h "$commit")"
  echo "pre-push: checking $(git log -1 --format='%h %s' "$commit")"
  mkdir -p "$WORK_PARENT"
  work="$(mktemp -d "$WORK_PARENT/check.XXXXXX")"
  git archive "$commit" | tar -x -C "$work"
  # A venv per commit: the checkout's editable install would make subprocess tests import
  # the worktree (including other people's uncommitted farmer/ edits) instead of this commit.
  uv venv -q --python 3.13 "$work/.venv"
  run_in "$work" uv pip install -q --python "$work/.venv/bin/python" -e ".[test]" mypy
  PY="$work/.venv/bin/python"
  for target in linux win32; do
    other=$([ "$target" = linux ] && echo windows || echo linux)
    run_in "$work" "$PY" -m mypy --python-version 3.13 --platform "$target" --follow-imports=silent \
      --exclude "midgard_farm/platform/${other}\.py$" src
  done
  # Pytest temp lives in $work so the trap removes it; the default /tmp/pytest-of-$USER
  # keeps ~600 MB per run and filled the /tmp quota on 2026-11-20.
  run_in "$work" env QT_QPA_PLATFORM=offscreen "$PY" -m pytest -q -p no:cacheprovider --basetemp="$work/.pytest-tmp" tests
  if grep -q '^farmer/' <<<"$changed"; then
    run_in "$work/farmer" "$PY" -m pytest -q -p no:cacheprovider --basetemp="$work/.pytest-tmp-farmer" tests
  fi
  rm -rf "$work"
  work=""
done
